# =============================================================================
# VulnLabelAnalyzer - .gitignore
# Tiene solo il codice del framework: niente dati, repository clonati, output
# di run, chiavi API o file generati.
# =============================================================================

# --- Segreti / configurazione locale -----------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
secrets.*
.secrets/

# --- Repository clonati (adatta al nome reale della cartella) ----------------
repos/
clones/

# --- Dataset e archivi -------------------------------------------------------
*.zip
*.tar.gz
*.tgz
diversevul_*.json
diversevul_*.jsonl

# --- Output passo 1 (dv_enricher) --------------------------------------------
work/
.dv_cache/

# --- Output passo 2 (main.py) e passo 3 (stats.py) ---------------------------
data/output/*
!data/output/.gitkeep

**/stats/*.md
**/stats/*.json
**/stats/*.csv

*.jsonl
*.csv
accuracy_summary.json
stats_report.txt
review_metrics.txt
review_metrics.json
review_report.md

# --- Eccezione: fixture di test (piccole, versionate) ------------------------
!tests/**/*.jsonl
!tests/**/*.json
!tests/**/*.csv
!tests/**/*.zip

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
.venv/
venv/
env/
ENV/

# --- Test, coverage, linting -------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.pytype/

# --- Notebook ----------------------------------------------------------------
.ipynb_checkpoints/

# --- Log e temporanei --------------------------------------------------------
*.log
*.tmp
*.bak
*.orig
tmp/
temp/

# --- IDE / editor ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# --- Sistema operativo -------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini